import sys, pathlib
from typing import List

# Ensure the evaluation modules are accessible
eval_path = str(pathlib.Path(__file__).parents[2] / "evaluation")
if eval_path not in sys.path:
    sys.path.insert(0, eval_path)

from schema import Document, Chunk
from base import BasePreprocessor

class Preprocessor(BasePreprocessor):
    name = "proposal_1"
    description = "Wikipedia Lead-focused chunking with Title propagation for BM25 optimization."

    def preprocess(self, docs: List[Document]) -> List[Chunk]:
        """
        Preprocesses Wikipedia documents for BM25 retrieval by focusing on the 
        lead sections where 'tip of the tongue' information is most concentrated.
        """
        all_chunks = []

        for doc in docs:
            doc_id = doc.doc_id
            # Try to retrieve title from metadata if available
            title = doc.metadata.get("title", "").strip()
            text = doc.text.strip() if doc.text else ""

            # Handle edge case for empty text
            if not text:
                all_chunks.append(Chunk(
                    doc_id=doc_id,
                    chunk_id=f"{doc_id}_0",
                    text=title if title else "empty"
                ))
                continue

            # Basic whitespace normalization
            words = text.split()
            
            # Constants for chunking
            # "Tip of the tongue" queries usually target the definition/summary of an entity.
            # BM25 benefits from relatively short, dense chunks to avoid score dilution.
            chunk_size = 400
            overlap = 100
            max_chunks_per_doc = 5  # Limits noise from bibliography/references in long articles

            for i in range(max_chunks_per_doc):
                start_idx = i * (chunk_size - overlap)
                
                # Stop if we've consumed the text
                if start_idx >= len(words) and i > 0:
                    break
                
                end_idx = start_idx + chunk_size
                chunk_words = words[start_idx:end_idx]
                
                if not chunk_words:
                    break
                
                body = " ".join(chunk_words)
                
                # Title Propagation: Prepend the title to every chunk.
                # In BM25, frequency matters. Repeating the title twice ensures 
                # the subject entity has a high term weight in every chunk.
                if title:
                    # Ensure the entity name is strongly associated with the description
                    chunk_text = f"{title}. {title}. {body}"
                else:
                    chunk_text = body

                all_chunks.append(Chunk(
                    doc_id=doc_id,
                    chunk_id=f"{doc_id}_{i}",
                    text=chunk_text
                ))

                # Check if we finished the document
                if end_idx >= len(words):
                    break

        return all_chunks
